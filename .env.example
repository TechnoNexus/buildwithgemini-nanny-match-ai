# ==============================================================================
# NannyMatch AI — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: 100% Free Local Mode (Zero GCP Billing, Google AI Studio)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fast, generous free-tier model (e.g., gemini-2.5-flash or gemini-2.0-flash)
MODEL=gemini-2.5-flash

# Optional: Google Maps API key for Geocoding & Places.
# If omitted, NannyMatch AI automatically falls back to free OpenStreetMap Nominatim!
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ------------------------------------------------------------------------------
# OPTION 2: Google Cloud Vertex AI Deployed Mode
# ------------------------------------------------------------------------------
# Uncomment and populate when deploying to GCP Vertex AI Reasoning Engines:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# USE_FIRESTORE=true
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# AGENT_ENGINE_RESOURCE_NAME=projects/<PROJECT_ID>/locations/us-east1/reasoningEngines/<ID>
# GCS_BUCKET_NAME=your-gcs-bucket-name
